{
  "name": "skillprint-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "api:dev": "wrangler dev --config worker/wrangler.toml",
    "api:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "wrangler": "^4.14.0"
  }
}
